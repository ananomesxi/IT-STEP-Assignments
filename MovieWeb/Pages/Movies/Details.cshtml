@page
@model MovieWeb.Pages.Movies.DetailsModel
<link rel="stylesheet" href="~/css/movies.css" asp-append-version="true" />

<main class="movies-page container py-5">
    @if (Model.Movie is null)
    {
        <section class="movie-details-panel">
            <p class="movies-eyebrow mb-2">MOVIE DETAILS</p>
            <h1 class="h2 mb-3">Movie not found</h1>
            <p class="text-secondary">The movie may have been removed or the link may be incorrect.</p>
            <a asp-page="/Movies/Index" class="btn btn-outline-primary movie-back-button">← Back to Movies</a>
        </section>
    }
    else
    {
        <article class="movie-details-panel">
            <p class="movies-eyebrow mb-2">MOVIE DETAILS</p>
            <h1 class="movie-details-title mb-4">@Model.Movie.Title</h1>

            <dl class="movie-facts">
                <div class="movie-fact">
                    <dt>Release year</dt>
                    <dd>@Model.Movie.ReleaseYear</dd>
                </div>
                <div class="movie-fact">
                    <dt>Studio</dt>
                    <dd>@Model.Movie.StudioName</dd>
                </div>
            </dl>

            <a asp-page="/Movies/Index" class="btn btn-primary movie-back-button mt-3">← Back to Movies</a>
        </article>
    }
</main>
